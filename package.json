{
	"name": "inference-money",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"contracts/evm",
		"contracts/aztec"
	],
	"scripts": {
		"deploy:local": "bun packages/deployer/src/cli.ts deploy local",
		"deploy:testnet": "bun run --cwd packages/deployer deploy:testnet",
		"lint": "biome check . && sort-package-json --check package.json 'packages/*/package.json' 'apps/*/package.json' 'contracts/*/package.json' && bun run lint:shell",
		"lint:actions": "actionlint",
		"lint:fix": "biome check --write . && sort-package-json package.json 'packages/*/package.json' 'apps/*/package.json' 'contracts/*/package.json'",
		"lint:shell": "git ls-files -z '*.sh' | xargs -0 -r shellcheck",
		"net:down": "bun packages/local-network/src/cli.ts down",
		"net:status": "bun packages/local-network/src/cli.ts status",
		"net:up": "bun packages/local-network/src/cli.ts up",
		"prepare": "husky",
		"probe:testnet": "bun run --cwd packages/deployer probe:testnet",
		"secrets:scan": "bun run --cwd packages/deployer secrets:scan",
		"smoke:testnet": "bun run --cwd packages/deployer smoke:testnet",
		"spike:proof-compat": "bun run --cwd packages/deployer spike:proof-compat",
		"test": "bun run --filter './packages/*' --filter './apps/*' --filter './contracts/*' --if-present test",
		"test:evm": "bun run --cwd contracts/evm test:evm",
		"test:evm:fork": "bun run --cwd contracts/evm test:evm:fork",
		"test:evm:formal": "bun run --cwd contracts/evm test:evm:formal",
		"test:evm:gas": "bun run --cwd contracts/evm test:evm:gas",
		"test:integration": "bun run --cwd packages/integration test:integration",
		"test:noir": "bun run --cwd contracts/aztec test:noir",
		"typecheck": "bun run --filter './packages/*' --filter './apps/*' --filter './contracts/*' --if-present typecheck",
		"verify:local": "bun packages/deployer/src/cli.ts verify local",
		"verify:testnet": "bun run --cwd packages/deployer verify:testnet"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"sort-package-json": "4.0.0",
		"typescript": "6.0.3"
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.4.0"
	}
}
