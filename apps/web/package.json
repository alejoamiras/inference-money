{
	"name": "@inference-money/web",
	"version": "0.0.0",
	"private": true,
	"description": "USDC Bridge: move USDC between Ethereum and Aztec from the browser.",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:test-wallet": "vite build --config e2e/test-wallet/vite.config.ts",
		"build:testnet": "BRIDGE_TARGET=testnet vite build && BUILT_TARGET=testnet vitest run build/manifest-identity.test.ts",
		"dev": "vite",
		"preview": "vite preview",
		"test": "vitest run",
		"test:components": "vitest run",
		"test:e2e": "bash e2e/agent.sh",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p e2e/run/tsconfig.json"
	},
	"dependencies": {
		"@aztec-labs/aztec.js": "6.0.0-rc.1",
		"@aztec-labs/foundation": "6.0.0-rc.1",
		"@aztec-labs/standard-contracts": "6.0.0-rc.1",
		"@aztec-labs/stdlib": "6.0.0-rc.1",
		"@aztec-labs/wallet-sdk": "6.0.0-rc.1",
		"@inference-money/bridge-core": "workspace:*",
		"@tanstack/react-query": "5.103.1",
		"clsx": "2.1.1",
		"radix-ui": "1.6.7",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"viem": "2.56.7",
		"wagmi": "3.7.7"
	},
	"devDependencies": {
		"@aztec-labs/wallets": "6.0.0-rc.1",
		"@inference-money/deployer": "workspace:*",
		"@inference-money/local-network": "workspace:*",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"jsdom": "30.1.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.0",
		"vite-plugin-node-polyfills": "0.28.0",
		"vitest": "5.0.1"
	}
}
